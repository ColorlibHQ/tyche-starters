		"area": "footer",
		"content": "<!-- wp:group {\"align\":\"full\",\"className\":\"tyche-footer\",\"backgroundColor\":\"dark\",\"textColor\":\"on-dark\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull tyche-footer has-dark-background-color has-background has-on-dark-color has-text-color\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--40)\">\n<!-- wp:columns {\"align\":\"wide\",\"className\":\"tyche-footer__columns\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|60\",\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns alignwide tyche-footer__columns\">\n<!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\">\n<!-- wp:site-title {\"level\":0,\"className\":\"tyche-footer__title\"} /-->\n<!-- wp:paragraph {\"className\":\"tyche-footer__about\"} -->\n<p class=\"tyche-footer__about\">Six people making solid timber furniture to order, behind a mill. Nothing in stock, ten years on every joint.</p>\n<!-- /wp:paragraph -->\n<!-- wp:social-links {\"iconColor\":\"overlay\",\"iconColorValue\":\"#ffffff\",\"size\":\"has-normal-icon-size\",\"className\":\"is-style-logos-only tyche-footer__social\",\"layout\":{\"type\":\"flex\"}} -->\n<ul class=\"wp-block-social-links has-normal-icon-size has-icon-color is-style-logos-only tyche-footer__social\">\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"instagram\"} /-->\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"pinterest\"} /-->\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"tiktok\"} /-->\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"facebook\"} /-->\n</ul>\n<!-- /wp:social-links -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:heading {\"className\":\"tyche-footer__heading\"} -->\n<h2 class=\"wp-block-heading tyche-footer__heading\">Shop</h2>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"overlayMenu\":\"never\",\"className\":\"tyche-footer__links\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}}} -->\n<!-- wp:navigation-link {\"label\":\"Tables\",\"url\":\"{{cat:tables}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Seating\",\"url\":\"{{cat:seating}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Storage\",\"url\":\"{{cat:storage}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Homeware\",\"url\":\"{{cat:homeware}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- /wp:navigation -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:heading {\"className\":\"tyche-footer__heading\"} -->\n<h2 class=\"wp-block-heading tyche-footer__heading\">Learn</h2>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"overlayMenu\":\"never\",\"className\":\"tyche-footer__links\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}}} -->\n<!-- wp:navigation-link {\"label\":\"Materials and care\",\"url\":\"{{page:materials}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Journal\",\"url\":\"{{page:journal}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"FAQ\",\"url\":\"{{page:faq}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Delivery and returns\",\"url\":\"{{page:delivery-returns}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- /wp:navigation -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:heading {\"className\":\"tyche-footer__heading\"} -->\n<h2 class=\"wp-block-heading tyche-footer__heading\">Oakhouse</h2>\n<!-- /wp:heading -->\n<!-- wp:navigation {\"overlayMenu\":\"never\",\"className\":\"tyche-footer__links\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}}} -->\n<!-- wp:navigation-link {\"label\":\"The workshop\",\"url\":\"{{page:about}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Showroom\",\"url\":\"{{page:showroom}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"Trade\",\"url\":\"{{page:trade}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- wp:navigation-link {\"label\":\"My account\",\"url\":\"{{account}}\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->\n<!-- /wp:navigation -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n\n<!-- wp:separator {\"align\":\"wide\",\"className\":\"is-style-wide tyche-footer__rule\"} -->\n<hr class=\"wp-block-separator alignwide has-alpha-channel-opacity is-style-wide tyche-footer__rule\"/>\n<!-- /wp:separator -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"tyche-footer__bottom\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group alignwide tyche-footer__bottom\">\n<!-- wp:paragraph {\"className\":\"tyche-footer__legal\",\"fontSize\":\"small\"} -->\n<p class=\"tyche-footer__legal has-small-font-size\">Timber from managed European forests.</p>\n<!-- /wp:paragraph -->\n<!-- wp:pattern {\"slug\":\"tyche/footer-payments\"} /-->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
